{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://capstone.local/contracts/fingerprint.schema.json",
  "title": "Fingerprint record",
  "description": "One windowed, normalized contextual fingerprint: network (28) + syscall (11) + energy (6) features.",
  "version": "2.0.0",
  "type": "object",
  "required": [
    "schema_version",
    "window_id",
    "window_start_epoch",
    "window_end_epoch",
    "label",
    "features"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "window_id": {
      "type": "integer",
      "minimum": 0
    },
    "window_start_epoch": {
      "type": "number"
    },
    "window_end_epoch": {
      "type": "number"
    },
    "device_ip": {
      "type": "string"
    },
    "firmware_id": {
      "type": "string"
    },
    "mirror_if": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "enum": [
        "benign",
        "malware",
        "healing",
        "unlabeled"
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "features": {
      "type": "object",
      "description": "All values min-max normalized to [0,1]. Order: network, syscall, energy.",
      "required": [
        "pkt_count",
        "byte_count",
        "mean_pkt_size",
        "std_pkt_size",
        "mean_iat",
        "std_iat",
        "pkts_per_sec",
        "bytes_per_sec",
        "frac_tcp",
        "frac_udp",
        "frac_icmp",
        "frac_arp",
        "frac_other",
        "n_unique_src_ports",
        "n_unique_dst_ports",
        "frac_syn",
        "frac_ack",
        "frac_rst",
        "mean_ttl",
        "n_dns_mdns",
        "n_dhcp",
        "n_arp_req",
        "n_arp_reply",
        "n_http",
        "n_https",
        "n_broadcast",
        "n_multicast",
        "distinct_l4_services",
        "sys_count",
        "sys_per_sec",
        "sys_unique",
        "sys_rare_count",
        "sys_entropy",
        "sys_frac_net",
        "sys_frac_file",
        "sys_frac_proc",
        "sys_n_exec",
        "sys_ngram_unique",
        "sys_n_pids",
        "energy_mean_power",
        "energy_peak_power",
        "energy_j",
        "energy_cpu_util",
        "energy_io_ops",
        "energy_per_syscall"
      ],
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "normalization": {
          "type": "string"
        },
        "n_features": {
          "type": "integer"
        },
        "monitors": {
          "type": "object",
          "description": "Which monitors were live for this window.",
          "properties": {
            "network": {
              "type": "string"
            },
            "syscall": {
              "type": "string"
            },
            "energy": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "x-feature-groups": {
    "network": [
      "pkt_count",
      "byte_count",
      "mean_pkt_size",
      "std_pkt_size",
      "mean_iat",
      "std_iat",
      "pkts_per_sec",
      "bytes_per_sec",
      "frac_tcp",
      "frac_udp",
      "frac_icmp",
      "frac_arp",
      "frac_other",
      "n_unique_src_ports",
      "n_unique_dst_ports",
      "frac_syn",
      "frac_ack",
      "frac_rst",
      "mean_ttl",
      "n_dns_mdns",
      "n_dhcp",
      "n_arp_req",
      "n_arp_reply",
      "n_http",
      "n_https",
      "n_broadcast",
      "n_multicast",
      "distinct_l4_services"
    ],
    "syscall": [
      "sys_count",
      "sys_per_sec",
      "sys_unique",
      "sys_rare_count",
      "sys_entropy",
      "sys_frac_net",
      "sys_frac_file",
      "sys_frac_proc",
      "sys_n_exec",
      "sys_ngram_unique",
      "sys_n_pids"
    ],
    "energy": [
      "energy_mean_power",
      "energy_peak_power",
      "energy_j",
      "energy_cpu_util",
      "energy_io_ops",
      "energy_per_syscall"
    ]
  }
}